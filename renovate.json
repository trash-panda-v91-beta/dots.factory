{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>trash-panda-v91-beta/renovate-config"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },
  "customManagers": [
    {
      "description": "fnox version pinned in mise global config inside dev-tools.nix",
      "customType": "regex",
      "managerFilePatterns": ["modules/aspects/tool/dev-tools\\.nix"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+fnox = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group herdr dependency updates",
      "groupName": "herdr deps",
      "matchFileNames": ["packages/herdr/**"],
      "schedule": ["every weekend"]
    },
    {
      "description": "Group misdr dependency updates",
      "groupName": "misdr deps",
      "matchFileNames": ["packages/misdr/**"],
      "schedule": ["every weekend"]
    },
    {
      "description": "Group aws-ext dependency updates",
      "groupName": "aws-ext deps",
      "matchFileNames": ["packages/aws-ext/**"],
      "schedule": ["every weekend"]
    },
    {
      "description": "Group aws-ext dependency updates",
      "groupName": "aws-ext deps",
      "matchFileNames": ["modules/aspects/bundle/aws-ext/package-lock.json"],
      "schedule": ["every weekend"]
    },
    {
      "description": "Group all mise tool updates into a single PR",
      "groupName": "mise tools",
      "matchManagers": ["mise"],
      "schedule": ["every weekend"]
    },
    {
      "description": "Group fnox custom manager update with mise tools",
      "groupName": "mise tools",
      "matchManagers": ["regex"],
      "matchFileNames": ["modules/aspects/tool/dev-tools.nix"],
      "schedule": ["every weekend"]
    }
  ]
}
